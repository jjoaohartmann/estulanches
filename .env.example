# Copie este arquivo para ".env" e troque os valores:  cp .env.example .env
# NUNCA envie o arquivo .env para o GitHub (ele está no .gitignore).

# Banco de dados (PostgreSQL)
DB_USER=estulanches
DB_PASSWORD=troque-esta-senha-do-banco
DB_NAME=estulanches

# Chave de administrador (painel da cantina). Mínimo de 16 caracteres.
ADMIN_API_KEY=troque-esta-chave-admin-123
